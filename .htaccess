RewriteEngine On
#RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)\?*$ index.php/$1 [L,QSA]


# Auth
#
# /mcp is excluded from Basic Auth — MCP clients can't complete an
# interactive login prompt. It authenticates itself via bearer token
# instead (see McpController); every other path keeps requiring the
# site-wide login.
#
# The regex matches both the original request URI (/mcp) and its
# mod_rewrite-internal-redirect form (/index.php/mcp): the RewriteRule
# above triggers an internal redirect that re-runs access control against
# the rewritten URI, so both forms have to be covered for the exclusion
# to actually take effect.
#
# CGIPassAuth is scoped to this block (not vhost-wide) so only /mcp
# requests hand their raw Authorization header to PHP via
# $_SERVER['HTTP_AUTHORIZATION'] — mod_php strips it by default (it's
# reserved for Apache's own Basic Auth), which would otherwise leave
# McpController unable to read the bearer token even with /mcp excluded
# from Basic Auth. Every other path keeps the header hidden from PHP.
<If "%{REQUEST_URI} =~ m#^(?:/index\.php)?/mcp(?:/|$)#">
    CGIPassAuth On
    Require all granted
</If>
<Else>
    AuthType Basic
    AuthName "Authentication Required"
    AuthUserFile "/app/.htpasswd"
    Require valid-user
</Else>


